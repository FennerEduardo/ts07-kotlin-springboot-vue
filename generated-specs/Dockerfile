# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (Kotlin · Spring Boot 3 (Gradle)).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 8080; probes: liveness /health, readiness /health/ready.

FROM gradle:8.10-jdk17 AS build
WORKDIR /app
COPY . .
RUN gradle -q --no-daemon bootJar && cp $(ls build/libs/*.jar | grep -v -- '-plain.jar') /app/app.jar

FROM eclipse-temurin:17-jre
RUN useradd --system --uid 10001 --no-create-home app
WORKDIR /app
COPY --from=build /app/app.jar app.jar
USER 10001
ENV SERVER_PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
